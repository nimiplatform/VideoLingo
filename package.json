{
  "name": "videolingo-nimi",
  "version": "0.2.0",
  "private": true,
  "description": "VideoLingo video translation and dubbing for Nimi",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "VideoLingo contributors",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "node scripts/dev-renderer.mjs",
    "init": "nimi-app init --adopt",
    "sync": "nimi-app sync",
    "check": "nimi-app check",
    "typecheck": "tsc --noEmit",
    "test": "nimi-app test",
    "test:app": "node scripts/setup-business.mjs && node --import tsx --test tests/nimi-*.test.ts",
    "setup:business": "node scripts/setup-business.mjs",
    "test:packaged-backend": "node --import tsx scripts/check-packaged-backend.mjs",
    "build:component": "node scripts/build-component.mjs",
    "build:electron": "node scripts/build-host.mjs",
    "build:electron:production": "node scripts/setup-business.mjs && node scripts/build-production.mjs",
    "app:build": "nimi-app build",
    "pack": "nimi-app pack",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "dev:web": "nimi-app dev --platform web --realm local",
    "dev:web-renderer": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "build:web:release": "vite build --config vite.web.config.ts --mode web-release",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "sync:android": "pnpm run build:mobile && cap sync android",
    "dev:android": "pnpm run sync:android && cap run android --no-sync",
    "dev:mobile": "nimi-app dev --platform mobile --realm local"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@nimiplatform/sdk": "^0.24.0-rc.10",
    "@nimiplatform/kit": "^0.24.0-rc.16"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "yaml": "^2.9.0",
    "@capacitor/cli": "8.6.0",
    "@nimiplatform/app-tools": "^0.16.0-rc.10",
    "@nimiplatform/nimi-coding": "0.7.0"
  }
}
